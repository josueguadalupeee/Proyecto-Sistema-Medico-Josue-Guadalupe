# Copia este archivo como .env y completa tus valores. El archivo .env NUNCA se sube a GitHub.

# Django
SECRET_KEY=genera-una-clave-nueva
DEBUG=True

# Base de datos PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=db_medico
DB_USER=postgres
DB_PASSWORD=tu-contraseña
DB_HOST=localhost
DB_PORT=5432

# Gmail para enviar correos (usa una "contraseña de aplicación")
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicación
DEFAULT_FROM_EMAIL=tu-correo@gmail.com
